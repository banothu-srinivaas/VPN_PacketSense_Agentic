# 5G-PacketSense Integrated — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Only the variables you need are required.
# Lines starting with # are comments and ignored.

# ── LLM Provider ─────────────────────────────────────────
# Which LLM backend to use for natural-language queries.
# Options: ollama, openai, anthropic, openrouter, gemini
LLM_PROVIDER=ollama

# ── Ollama (local, free) ─────────────────────────────────
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Anthropic Claude ──────────────────────────────────────
ANTHROPIC_API_KEY=

# ── OpenRouter (supports multiple models) ─────────────────
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ── Google Gemini ─────────────────────────────────────────
GEMINI_API_KEY=

# ── VPN Detection ────────────────────────────────────────
# Optional: vpnapi.io API key for enhanced VPN detection.
# Free tier: 1000 queries/day. Works without a key (uses other detection layers).
# VPNAPI_IO_KEY=

# ── Application Settings ─────────────────────────────────
TALK_TO_PCAP_DATA_DIR=./data
TALK_TO_PCAP_LOG_LEVEL=INFO
