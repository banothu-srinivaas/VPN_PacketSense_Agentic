@app.route("/api/flows", methods=["GET"])
def get_flows():
    """Get packet flows from loaded PCAP"""
    if not conn:
        return jsonify({"error": "No PCAP loaded. Use /api/load_parquet first."}), 400

    limit = int(request.args.get("limit", 100))
    protocol = request.args.get("protocol", None)
    min_packets = int(request.args.get("min_packets", 1))
    start_time = request.args.get("start")
    end_time = request.args.get("end")

    sql = f"""
        SELECT 
            {COLS['src']} as src_ip,
            {COLS['dst']} as dst_ip,
            COUNT(*) as packet_count,
            COALESCE(SUM(TRY_CAST({COLS['len']} AS INTEGER)), 0) as total_bytes,
            COALESCE(AVG(TRY_CAST({COLS['len']} AS INTEGER)), 0) as avg_packet_size
        FROM packets
        WHERE {COLS['src']} IS NOT NULL 
          AND {COLS['dst']} IS NOT NULL
    """

    if start_time and end_time:
        sql += f" AND {COLS['time']} BETWEEN {start_time} AND {end_time}"

    if protocol:
        sql += f" AND {COLS['proto']} LIKE '%{protocol}%'"

    sql += f"""
        GROUP BY src_ip, dst_ip
        HAVING COUNT(*) >= {min_packets}
        ORDER BY packet_count DESC
        LIMIT {limit}
    """

    try:
        print(f"[DEBUG] Executing flows query: {sql}")
        result = conn.execute(sql).fetchall()
        flows = []
        skipped_count = 0
        for row in result:
            src_ip, dst_ip, packet_count, total_bytes, avg_size = row
            src_geo = get_geolocation(src_ip)
            dst_geo = get_geolocation(dst_ip)

            # Skip flows where either location is unknown
            if not src_geo or not dst_geo:
                skipped_count += 1
                continue

            flows.append(
                {
                    "src": {"ip": src_ip, **src_geo},
                    "dst": {"ip": dst_ip, **dst_geo},
                    "stats": {
                        "packet_count": int(packet_count),
                        "total_bytes": int(total_bytes) if total_bytes else 0,
                        "avg_packet_size": float(avg_size) if avg_size else 0,
                    },
                }
            )

        if skipped_count > 0:
            print(f"[INFO] Skipped {skipped_count} flows with unknown locations")

        return jsonify({"flows": flows, "total": len(flows), "skipped": skipped_count})
    except Exception as e:
        print(f"[ERROR] Error flows: {e}")
        return jsonify({"error": str(e)}), 500


@app.route("/api/stats", methods=["GET"])
def get_stats():
    """Get packet statistics"""
    if not conn:
        return jsonify({"error": "No PCAP loaded"}), 400

    try:
        total = conn.execute("SELECT COUNT(*) FROM packets").fetchone()[0]
        u_src = conn.execute(
            f"SELECT COUNT(DISTINCT {COLS['src']}) FROM packets"
        ).fetchone()[0]
        u_dst = conn.execute(
            f"SELECT COUNT(DISTINCT {COLS['dst']}) FROM packets"
        ).fetchone()[0]

        protos = conn.execute(
            f"""
            SELECT {COLS['proto']}, COUNT(*) as count FROM packets
            WHERE {COLS['proto']} IS NOT NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
        """
        ).fetchall()

        # Top talkers by packet count
        top_talkers = conn.execute(
            f"""
            SELECT ip, SUM(packets) as total_packets, SUM(bytes) as total_bytes
            FROM (
                SELECT {COLS['src']} as ip, COUNT(*) as packets, 
                       COALESCE(SUM(TRY_CAST({COLS['len']} AS INTEGER)), 0) as bytes
                FROM packets WHERE {COLS['src']} IS NOT NULL
                GROUP BY {COLS['src']}
                UNION ALL
                SELECT {COLS['dst']} as ip, COUNT(*) as packets,
                       COALESCE(SUM(TRY_CAST({COLS['len']} AS INTEGER)), 0) as bytes
                FROM packets WHERE {COLS['dst']} IS NOT NULL
                GROUP BY {COLS['dst']}
            )
            GROUP BY ip
            ORDER BY total_bytes DESC
            LIMIT 10
        """
        ).fetchall()

        # Top ports by packet count (src_port and dst_port are used by both TCP and UDP)
        top_src_ports = conn.execute(
            f"""
            SELECT "src_port", COUNT(*) as count
            FROM packets
            WHERE "src_port" IS NOT NULL
            GROUP BY "src_port"
            ORDER BY count DESC
            LIMIT 5
        """
        ).fetchall()

        top_dst_ports = conn.execute(
            f"""
            SELECT "dst_port", COUNT(*) as count
            FROM packets
            WHERE "dst_port" IS NOT NULL
            GROUP BY "dst_port"
            ORDER BY count DESC
            LIMIT 5
        """
        ).fetchall()

        # Total bytes and average packet size
        total_bytes = conn.execute(
            f"SELECT COALESCE(SUM(TRY_CAST({COLS['len']} AS INTEGER)), 0) FROM packets"
        ).fetchone()[0]

        avg_packet_size = conn.execute(
            f"SELECT COALESCE(AVG(TRY_CAST({COLS['len']} AS INTEGER)), 0) FROM packets"
        ).fetchone()[0]

        # Time range
        time_range = conn.execute(
            f"SELECT MIN({COLS['time']}), MAX({COLS['time']}) FROM packets"
        ).fetchone()

        duration = (
            time_range[1] - time_range[0] if time_range[0] and time_range[1] else 0
        )
        packet_rate = total / duration if duration > 0 else 0

        # Count IPs with unknown locations
        all_ips = conn.execute(
            f"""
            SELECT DISTINCT ip FROM (
                SELECT {COLS['src']} as ip FROM packets WHERE {COLS['src']} IS NOT NULL
                UNION
                SELECT {COLS['dst']} as ip FROM packets WHERE {COLS['dst']} IS NOT NULL
            )
            """
        ).fetchall()

        unknown_location_count = 0
        vpn_ip_count = 0
        vpn_detail_list = []
        for (ip,) in all_ips:
            geo = get_geolocation(ip)
            if geo is None:
                unknown_location_count += 1
            elif geo.get("is_vpn"):
                vpn_ip_count += 1
                vpn_detail_list.append(
                    {
                        "ip": ip,
                        "provider": geo.get("vpn_provider", "Unknown"),
                        "isp": geo.get("isp", "Unknown"),
                        "country": geo.get("country", "Unknown"),
                        "city": geo.get("city", "Unknown"),
                        "method": geo.get("vpn_method", "keyword"),
                    }
                )

        return jsonify(
            {
                "total_packets": total,
                "unique_src_ips": u_src,
                "unique_dst_ips": u_dst,
                "protocols": [{"name": p[0], "count": p[1]} for p in protos],
                "top_talkers": [
                    {"ip": t[0], "packets": int(t[1]), "bytes": int(t[2])}
                    for t in top_talkers
                ],
                "top_src_ports": [
                    {"port": int(p[0]), "count": int(p[1])} for p in top_src_ports
                ],
                "top_dst_ports": [
                    {"port": int(p[0]), "count": int(p[1])} for p in top_dst_ports
                ],
                "total_bytes": int(total_bytes),
                "avg_packet_size": float(avg_packet_size),
                "duration": float(duration),
                "packet_rate": float(packet_rate),
                "unknown_locations": unknown_location_count,
                "vpn_ips_count": vpn_ip_count,
                "vpn_ips": list(vpn_ips)[:10],
                "vpn_details": vpn_detail_list[:10],
            }
        )
    except Exception as e:
        print(f"[ERROR] Stats error: {e}")
        import traceback

        traceback.print_exc()
        return jsonify({"error": str(e)}), 500


@app.route("/api/time_range", methods=["GET"])
def get_time_range():
    """Get time range from loaded PCAP"""
    if not conn:
        return jsonify({"error": "No PCAP loaded"}), 400

    try:
        result = conn.execute(
            f"SELECT MIN({COLS['time']}), MAX({COLS['time']}) FROM packets WHERE {COLS['time']} IS NOT NULL"
        ).fetchone()
        min_time = result[0]
        max_time = result[1]

        if min_time is None or max_time is None:
            return jsonify({"min": 0, "max": 0})

        if isinstance(min_time, str):
            min_time = float(min_time)
        if isinstance(max_time, str):
            max_time = float(max_time)

        return jsonify({"min": min_time, "max": max_time})
    except Exception as e:
        print(f"[ERROR] Error time_range: {e}")
        return jsonify({"error": str(e)}), 500


@app.route("/api/flow_details", methods=["GET"])
def get_flow_details():
    """Get detailed packet info for a specific flow"""
    if not conn:
        return jsonify({"error": "No PCAP loaded"}), 400

    src = request.args.get("src")
    dst = request.args.get("dst")
    limit = int(request.args.get("limit", 50))

    try:
        sql = f"""
            SELECT 
                {COLS['number']},
                {COLS['time']},
                {COLS['len']},
                {COLS['proto']}
            FROM packets
            WHERE {COLS['src']} = '{src}' AND {COLS['dst']} = '{dst}'
            ORDER BY {COLS['time']}
            LIMIT {limit}
        """
        result = conn.execute(sql).fetchall()
        packets = []
        for row in result:
            time_val = row[1]
            if isinstance(time_val, str):
                try:
                    time_val = float(time_val)
                except (ValueError, TypeError):
                    time_val = 0
            packets.append(
                {
                    "number": row[0],
                    "time": time_val,
                    "length": row[2],
                    "protocols": row[3],
                }
            )
        return jsonify({"packets": packets})
    except Exception as e:
        print(f"[ERROR] Error DPI: {e}")
        return jsonify({"error": str(e)}), 500


