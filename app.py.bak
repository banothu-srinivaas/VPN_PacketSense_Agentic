@app.route("/api/load_parquet", methods=["POST"])
def load_parquet_route():
    """Load a parquet file for analysis"""
    data = request.json
    path = data.get("path")

    if not path:
        return jsonify({"error": "No path provided"}), 400

    if not Path(path).exists():
        return jsonify({"error": f"File not found: {path}"}), 404

    try:
        load_parquet(path)
        return jsonify({"status": "success", "message": f"Loaded {path}", "path": path})
    except Exception as e:
        return jsonify({"error": str(e)}), 500


@app.route("/api/upload_pcap", methods=["POST"])
def upload_pcap():
    """Upload and process PCAP file"""
    if "file" not in request.files:
        return jsonify({"error": "No file provided"}), 400

    file = request.files["file"]
    if file.filename == "":
        return jsonify({"error": "No file selected"}), 400

    if not file.filename.endswith((".pcap", ".pcapng")):
        return jsonify({"error": "File must be .pcap or .pcapng"}), 400

    try:
        pcap_dir = Path("data/pcap")
        parquet_dir = Path("data/parquet")
        pcap_dir.mkdir(parents=True, exist_ok=True)
        parquet_dir.mkdir(parents=True, exist_ok=True)

        # Check if this is a live capture file that was just saved
        uploaded_filename = Path(file.filename).stem

        # Check if a matching parquet already exists (from live capture)
        matching_parquet = None
        for existing_parquet in parquet_dir.glob("*.parquet"):
            # Match if the base filename is the same (e.g., "live_capture_20260202_145350")
            if existing_parquet.stem == uploaded_filename:
                matching_parquet = existing_parquet
                print(
                    f"[INFO] Found matching parquet from live capture: {matching_parquet}"
                )
                break

        if matching_parquet and matching_parquet.exists():
            # Use existing parquet instead of re-processing
            print(f"[INFO] Reusing existing parquet file: {matching_parquet}")

            # Count packets in existing parquet
            import duckdb

            temp_conn = duckdb.connect(":memory:")
            temp_conn.execute(
                f"CREATE TABLE packets AS SELECT * FROM read_parquet('{matching_parquet}')"
            )
            packet_count = temp_conn.execute("SELECT COUNT(*) FROM packets").fetchone()[
                0
            ]
            temp_conn.close()

            # Load into main DuckDB connection
            load_parquet(str(matching_parquet))

            return jsonify(
                {
                    "status": "success",
                    "message": f"Loaded existing capture with {packet_count} packets",
                    "parquet_path": str(matching_parquet),
                    "packet_count": packet_count,
                    "reused": True,
                }
            )

        # File doesn't exist, process normally
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        safe_filename = uploaded_filename
        pcap_path = pcap_dir / f"{safe_filename}_{timestamp}.pcap"
        parquet_path = parquet_dir / f"{safe_filename}_{timestamp}.parquet"

        file.save(str(pcap_path))
        print(f"[INFO] Saved uploaded PCAP: {pcap_path}")

        # Convert to Parquet
        from src.parsers.scapy_parser import parse_pcap_with_scapy
        from src.transformers.json_to_parquet import write_parquet_streaming

        print(f"[INFO] Converting PCAP to Parquet...")
        packets = parse_pcap_with_scapy(str(pcap_path))

        if not packets:
            return jsonify({"error": "No packets found in PCAP file"}), 400

        write_parquet_streaming(packets, str(parquet_path))
        print(f"[INFO] Converted {len(packets)} packets to Parquet: {parquet_path}")

        # Load into DuckDB
        load_parquet(str(parquet_path))

        return jsonify(
            {
                "status": "success",
                "message": f"Loaded {len(packets)} packets from {file.filename}",
                "pcap_path": str(pcap_path),
                "parquet_path": str(parquet_path),
                "packet_count": len(packets),
                "reused": False,
            }
        )

    except Exception as e:
        print(f"[ERROR] Upload failed: {e}")
        return jsonify({"error": str(e)}), 500


