@app.route("/api/live/start")
def start_live_capture():
    """Start live packet capture"""
    global capture_running, GEOIP_CACHE, VPN_CACHE, vpn_ips
    if not capture_running:
        # Clear caches to ensure fresh VPN detection
        print("[INFO] Clearing GeoIP and VPN caches for fresh detection")
        GEOIP_CACHE.clear()
        VPN_CACHE.clear()
        vpn_ips.clear()
        live_stats["vpn_ips"].clear()
        live_stats["vpn_details"].clear()

        # Start capture in a background thread
        capture_thread = threading.Thread(target=start_capture, daemon=True)
        capture_thread.start()

        return jsonify({"status": "started", "message": "Live packet capture started"})
    return jsonify({"status": "already_running", "message": "Capture already running"})


@app.route("/api/live/stop")
def stop_live_capture():
    """Stop live packet capture and auto-save"""
    global capture_running, captured_packets, capture_session_name
    capture_running = False

    # Auto-save captured packets
    save_result = {"status": "stopped", "message": "Live packet capture stopped"}

    if captured_packets:
        try:
            # Ensure data directories exist
            pcap_dir = Path("data/pcap")
            parquet_dir = Path("data/parquet")
            pcap_dir.mkdir(parents=True, exist_ok=True)
            parquet_dir.mkdir(parents=True, exist_ok=True)

            # Save to PCAP
            pcap_filename = f"{capture_session_name}.pcap"
            pcap_path = pcap_dir / pcap_filename
            wrpcap(str(pcap_path), captured_packets)

            print(f"[INFO] Auto-saved {len(captured_packets)} packets to {pcap_path}")

            # Convert to Parquet
            parquet_filename = f"{capture_session_name}.parquet"
            parquet_path = parquet_dir / parquet_filename

            try:
                from src.parsers.scapy_parser import parse_pcap_with_scapy
                from src.transformers.json_to_parquet import write_parquet_streaming

                print(f"[INFO] Converting PCAP to Parquet using Scapy...")

                packets = parse_pcap_with_scapy(str(pcap_path))

                if packets:
                    write_parquet_streaming(packets, str(parquet_path))
                    print(
                        f"[INFO] Converted {len(packets)} packets to Parquet: {parquet_path}"
                    )

                    save_result.update(
                        {
                            "saved": True,
                            "pcap_file": str(pcap_path),
                            "parquet_file": str(parquet_path),
                            "packet_count": len(captured_packets),
                        }
                    )
                else:
                    print(f"[WARN] No packets parsed from PCAP")
                    save_result.update(
                        {
                            "saved": True,
                            "pcap_file": str(pcap_path),
                            "packet_count": len(captured_packets),
                            "parquet_error": "No packets parsed from PCAP",
                        }
                    )

            except FileNotFoundError as e:
                print(f"[ERROR] File not found: {e}")
                save_result.update(
                    {
                        "saved": True,
                        "pcap_file": str(pcap_path),
                        "packet_count": len(captured_packets),
                        "parquet_error": f"File not found: {str(e)}",
                    }
                )
            except Exception as e:
                print(f"[WARN] Parquet conversion failed: {e}")
                save_result.update(
                    {
                        "saved": True,
                        "pcap_file": str(pcap_path),
                        "packet_count": len(captured_packets),
                        "parquet_error": str(e),
                    }
                )

        except Exception as e:
            print(f"[ERROR] Failed to save capture: {e}")
            save_result["save_error"] = str(e)
    else:
        save_result["message"] += " (no packets captured)"

    return jsonify(save_result)


@app.route("/api/live/stats")
def get_live_stats():
    """Get live capture statistics with enhanced metrics"""
    uptime = time.time() - live_stats["start_time"] if live_stats["start_time"] else 0

    # Calculate top talkers (top 5)
    top_talkers = sorted(
        live_stats["top_talkers"].items(), key=lambda x: x[1], reverse=True
    )[:5]

    # Calculate top ports (top 5)
    top_ports = sorted(live_stats["ports"].items(), key=lambda x: x[1], reverse=True)[
        :5
    ]

    # Calculate bandwidth (bytes per second)
    bandwidth = live_stats["total_bytes"] / uptime if uptime > 0 else 0

    return jsonify(
        {
            "total_packets": live_stats["total_packets"],
            "tcp_packets": live_stats["tcp_packets"],
            "udp_packets": live_stats["udp_packets"],
            "unique_ips": len(live_stats["unique_ips"]),
            "unique_src_ips": len(live_stats["unique_src_ips"]),
            "unique_dst_ips": len(live_stats["unique_dst_ips"]),
            "active_connections": len(live_stats["connections"]),
            "capture_running": capture_running,
            "uptime": uptime,
            "total_bytes": live_stats["total_bytes"],
            "bandwidth_bps": bandwidth,
            "protocols": dict(live_stats["protocols"]),
            "top_talkers": [
                {"ip": ip, "bytes": bytes_count} for ip, bytes_count in top_talkers
            ],
            "top_ports": [{"port": port, "count": count} for port, count in top_ports],
            "captured_packets_count": len(captured_packets),
            "session_name": capture_session_name,
            "vpn_ips_count": len(live_stats["vpn_ips"]),
            "vpn_ips": list(live_stats["vpn_ips"])[:10],
            "vpn_details": list(live_stats["vpn_details"].values())[:10],
        }
    )


@app.route("/api/vpn/status")
def get_vpn_db_status():
    """Get VPN detection database status"""
    vpn_lists_dir = Path("data/vpn_lists")
    sources_status = {}
    for name in ["x4bnet_ipv4", "tor_exit_nodes"]:
        cache_file = vpn_lists_dir / f"{name}.txt"
        if cache_file.exists():
            age_hours = (time.time() - cache_file.stat().st_mtime) / 3600
            line_count = len(cache_file.read_text().strip().splitlines())
            sources_status[name] = {
                "loaded": True,
                "entries": line_count,
                "age_hours": round(age_hours, 1),
            }
        else:
            sources_status[name] = {"loaded": False, "entries": 0, "age_hours": None}

    return jsonify(
        {
            "ip_ranges_loaded": len(VPN_IP_RANGES_V4),
            "asn_entries": len(VPN_ASN_DATABASE),
            "keyword_providers": len(VPN_PROVIDERS),
            "cached_lookups": len(VPN_CACHE),
            "vpn_ips_detected": len(vpn_ips),
            "vpnapi_io_configured": bool(VPNAPI_IO_KEY),
            "sources": sources_status,
            "detection_layers": [
                "ISP/Org keyword matching",
                "Known VPN ASN database",
                "X4BNet VPN IP ranges (GitHub)",
                "Tor exit node list",
                "ip-api.com proxy detection",
                "vpnapi.io API" + (" (configured)" if VPNAPI_IO_KEY else " (no key)"),
            ],
        }
    )


@app.route("/api/vpn/refresh", methods=["POST"])
def refresh_vpn_db():
    """Force refresh VPN IP databases from public sources"""
    global VPN_CACHE
    try:
        VPN_CACHE = {}  # Clear cache to re-evaluate with fresh data
        # Delete cached files to force re-download
        vpn_lists_dir = Path("data/vpn_lists")
        for f in vpn_lists_dir.glob("*.txt"):
            f.unlink()
        download_vpn_ip_lists()
        return jsonify(
            {
                "status": "success",
                "ip_ranges_loaded": len(VPN_IP_RANGES_V4),
                "message": "VPN databases refreshed successfully",
            }
        )
    except Exception as e:
        return jsonify({"status": "error", "message": str(e)}), 500


@app.route("/api/live/history")
def get_live_history():
    """Get recent packet history from live capture"""
    return jsonify(list(packet_history))


@app.route("/api/live/save")
def save_live_capture():
    """Save captured packets to PCAP file"""
    global captured_packets, capture_session_name

    if not captured_packets:
        return jsonify({"error": "No packets captured"}), 400

    try:
        # Ensure data directories exist
        pcap_dir = Path("data/pcap")
        parquet_dir = Path("data/parquet")
        pcap_dir.mkdir(parents=True, exist_ok=True)
        parquet_dir.mkdir(parents=True, exist_ok=True)

        # Save to PCAP
        pcap_filename = f"{capture_session_name}.pcap"
        pcap_path = pcap_dir / pcap_filename
        wrpcap(str(pcap_path), captured_packets)

        print(f"[INFO] Saved {len(captured_packets)} packets to {pcap_path}")

        # Convert to Parquet using CLI parser
        parquet_filename = f"{capture_session_name}.parquet"
        parquet_path = parquet_dir / parquet_filename

        # Import and use the parser
        from src.parsers.tshark_wrapper import TSharkWrapper
        from src.transformers.json_to_parquet import json_to_parquet

        try:
            print(f"[INFO] Converting PCAP to Parquet...")
            wrapper = TSharkWrapper()
            json_data = wrapper.parse_pcap(str(pcap_path))
            json_to_parquet(json_data, str(parquet_path))
            print(f"[INFO] Converted to Parquet: {parquet_path}")

            return jsonify(
                {
                    "status": "success",
                    "message": f"Saved {len(captured_packets)} packets",
                    "pcap_file": str(pcap_path),
                    "parquet_file": str(parquet_path),
                    "packet_count": len(captured_packets),
                }
            )
        except Exception as e:
            print(f"[WARN] Parquet conversion failed: {e}")
            return jsonify(
                {
                    "status": "partial",
                    "message": f"Saved PCAP but Parquet conversion failed",
                    "pcap_file": str(pcap_path),
                    "packet_count": len(captured_packets),
                    "error": str(e),
                }
            )

    except Exception as e:
        print(f"[ERROR] Error saving capture: {e}")
        return jsonify({"error": str(e)}), 500


@app.route("/api/live/load_saved")
def load_saved_capture():
    """Load the most recent saved capture for analysis (converts PCAP to Parquet if needed)"""
    global conn, parquet_path, capture_running

    try:
        pcap_dir = Path("data/pcap")
        parquet_dir = Path("data/parquet")

        # Ensure directories exist
        pcap_dir.mkdir(parents=True, exist_ok=True)
        parquet_dir.mkdir(parents=True, exist_ok=True)

        # Find most recent PCAP file
        pcap_files = list(pcap_dir.glob("*.pcap"))
        if not pcap_files:
            return jsonify({"error": "No saved captures found"}), 404

        latest_pcap = max(pcap_files, key=lambda p: p.stat().st_mtime)
        print(f"[INFO] Found latest PCAP: {latest_pcap}")

        # Check if corresponding Parquet exists
        parquet_file = parquet_dir / f"{latest_pcap.stem}.parquet"

        if not parquet_file.exists():
            print(f"[INFO] Parquet not found, converting {latest_pcap} to Parquet...")

            try:
                from src.parsers.scapy_parser import parse_pcap_with_scapy
                from src.transformers.json_to_parquet import write_parquet_streaming

                packets = parse_pcap_with_scapy(str(latest_pcap))

                if packets:
                    write_parquet_streaming(packets, str(parquet_file))
                    print(
                        f"[INFO] Successfully converted {len(packets)} packets to {parquet_file}"
                    )
                else:
                    raise Exception("No packets parsed from PCAP")

            except FileNotFoundError as e:
                return (
                    jsonify(
                        {
                            "error": f"File not found: {str(e)}",
                            "pcap_file": str(latest_pcap),
                        }
                    ),
                    500,
                )

            except Exception as e:
                print(f"[ERROR] Failed to convert PCAP to Parquet: {e}")
                return (
                    jsonify(
                        {
                            "error": f"Failed to convert PCAP to Parquet: {str(e)}",
                            "pcap_file": str(latest_pcap),
                        }
                    ),
                    500,
                )
        else:
            print(f"[INFO] Using existing Parquet: {parquet_file}")

        # Stop live capture if running
        capture_running = False
        time.sleep(0.5)

        # Load the parquet file
        load_parquet(str(parquet_file))

        return jsonify(
            {
                "status": "success",
                "message": f"Loaded {latest_pcap.name}",
                "pcap_file": str(latest_pcap),
                "parquet_file": str(parquet_file),
            }
        )

    except Exception as e:
        print(f"[ERROR] Error loading saved capture: {e}")
        import traceback

        traceback.print_exc()
        return jsonify({"error": str(e)}), 500


