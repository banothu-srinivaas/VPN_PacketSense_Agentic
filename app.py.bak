        {"city": "London", "country": "UK", "lat": 51.5074, "lon": -0.1278},
        {"city": "New York", "country": "USA", "lat": 40.7128, "lon": -74.0060},
        {"city": "Tokyo", "country": "Japan", "lat": 35.6762, "lon": 139.6503},
        {"city": "Sydney", "country": "Australia", "lat": -33.8688, "lon": 151.2093},
    ]
    ip_hash = int(hashlib.md5(ip.encode()).hexdigest()[:8], 16)
    location = cities[ip_hash % len(cities)]
    lat_offset = ((ip_hash % 100) / 1000.0) - 0.05
    lon_offset = ((ip_hash % 100) / 1000.0) - 0.05
    return {
        "lat": location["lat"] + lat_offset,
        "lon": location["lon"] + lon_offset,
        "country": location["country"],
        "city": location["city"],
    }


def get_local_ip_addresses():
    """Get all local IP addresses of the machine"""
    local_ips = []
    try:
        # Get hostname
        hostname = socket.gethostname()
        # Get all IPs associated with hostname
        ip_list = socket.getaddrinfo(hostname, None)
        for ip_info in ip_list:
            ip = ip_info[4][0]
            # Filter out IPv6 and loopback
            if ":" not in ip and not ip.startswith("127."):
                if ip not in local_ips:
                    local_ips.append(ip)
    except Exception as e:
        print(f"[WARN] Error getting local IPs: {e}")

    # Add common private IP ranges if nothing found
    if not local_ips:
        try:
            # Try connecting to external server to find default interface IP
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect(("8.8.8.8", 80))
            local_ip = s.getsockname()[0]
            s.close()
            local_ips.append(local_ip)
        except:
            pass

    return local_ips


def get_user_public_location():
    """Get user's public IP location for live capture"""
    global user_public_location
    if user_public_location:
        return user_public_location

    try:
        response = requests.get("https://api.ipify.org?format=json", timeout=3)
        if response.status_code == 200:
            public_ip = response.json().get("ip")
            response = requests.get(
                f"http://ip-api.com/json/{public_ip}?fields=status,country,city,lat,lon,isp,as,query",
                timeout=3,
            )
            if response.status_code == 200:
                data = response.json()
                if data.get("status") == "success":
                    isp = data.get("isp", "Unknown")
                    asn = data.get("as", "Unknown")
                    vpn_info = detect_vpn(public_ip, isp, asn)

                    user_public_location = {
                        "ip": public_ip,
                        "country": data.get("country", "Unknown"),
                        "city": data.get("city", "Unknown"),
                        "lat": data.get("lat", 0),
                        "lon": data.get("lon", 0),
                        "isp": isp,
                        "asn": asn,
                        "is_vpn": vpn_info["is_vpn"],
                        "vpn_provider": vpn_info["provider"],
                    }
                    print(
                        f"[INFO] Your public location: {user_public_location['city']}, {user_public_location['country']}"
                    )
                    if vpn_info["is_vpn"]:
                        print(
                            f"[INFO] Your connection appears to be using {vpn_info['provider']}"
                        )
                    return user_public_location
    except Exception as e:
        print(f"[WARN] Error getting public location: {e}")

    user_public_location = {
        "ip": "Local",
        "country": "Local Network",
        "city": "Your Location",
        "lat": 20,
        "lon": 0,
        "isp": "Local",
        "asn": "N/A",
        "is_vpn": False,
        "vpn_provider": None,
    }
    return user_public_location


def detect_vpn(ip, isp, asn):
    """Enhanced multi-layered VPN detection using public databases.

    Detection layers (in order of speed):
    1. Cache lookup
    2. ISP/Org keyword matching (fast, local)
    3. ASN number matching against known VPN ASNs (fast, local)
    4. IP range matching against X4BNet/Tor public lists (fast, local)
    5. ip-api.com proxy/hosting fields (already fetched)
    6. vpnapi.io public API (remote, rate-limited fallback)
    """
    # Check cache first
    cache_key = f"{ip}_{isp}_{asn}"
    if cache_key in VPN_CACHE:
        return VPN_CACHE[cache_key]

    detection_method = None

    # Layer 1: ISP/Org keyword matching
    check_text = f"{isp} {asn}".lower()
    for vpn_name, keywords in VPN_PROVIDERS.items():
        for keyword in keywords:
            if keyword in check_text:
                result = {"is_vpn": True, "provider": vpn_name, "method": "keyword"}
                VPN_CACHE[cache_key] = result
                print(f"[VPN-DETECTED] {vpn_name} detected for IP {ip} (keyword match)")
                return result

    # Layer 2: ASN number matching against known VPN ASNs
    if asn and asn != "Unknown" and asn != "N/A":
        # Extract ASN number (format: "AS12345 Organization Name")
        asn_number = asn.split()[0] if asn else ""
        if asn_number in VPN_ASN_DATABASE:
            provider = VPN_ASN_DATABASE[asn_number]
            result = {"is_vpn": True, "provider": provider, "method": "asn_database"}
            VPN_CACHE[cache_key] = result
            print(f"[VPN-DETECTED] {provider} detected for IP {ip} (ASN: {asn_number})")
            return result

    # Layer 3: Check against downloaded VPN IP range lists (X4BNet + Tor)
    if check_ip_in_vpn_ranges(ip):
        # Try to identify the provider from ISP if possible
        provider = "VPN Service (IP Database Match)"
        # Check if ISP name gives a hint
        isp_lower = (isp or "").lower()
        for vpn_name, keywords in VPN_PROVIDERS.items():
            for keyword in keywords:
                if keyword in isp_lower:
                    provider = vpn_name
                    break
        result = {"is_vpn": True, "provider": provider, "method": "ip_database"}
        VPN_CACHE[cache_key] = result
        print(f"[VPN-DETECTED] {provider} detected for IP {ip} (X4BNet/Tor IP list)")
        return result

    # Layer 4: vpnapi.io public API (fallback, rate-limited)
    # Only query for non-private IPs we haven't identified yet
    if not ip.startswith(("10.", "172.", "192.168.", "127.")):
        vpnapi_result = check_vpnapi_io(ip)
        if vpnapi_result and vpnapi_result.get("is_vpn"):
            result = {
                "is_vpn": True,
                "provider": vpnapi_result.get("provider", "VPN Service"),
                "method": "vpnapi.io",
            }
            VPN_CACHE[cache_key] = result
            print(
                f"[VPN-DETECTED] {result['provider']} detected for IP {ip} (vpnapi.io)"
            )
            return result

    # Not detected as VPN by any layer
    result = {"is_vpn": False, "provider": None, "method": None}
    VPN_CACHE[cache_key] = result
    return result


def get_ip_location_live(ip):
    """Get geographic location for live capture IP"""
    if ip in GEOIP_CACHE:
        return GEOIP_CACHE[ip]

    # Handle private IPs
    if ip.startswith(("10.", "172.", "192.168.", "127.", "169.254.")):
        fallback = get_user_public_location()
        if fallback:
            location = fallback.copy()
            location["ip"] = ip
            location["city"] = "Local Network"
            location["isp"] = "Private IP"
            location["asn"] = "N/A"
            location["is_vpn"] = False
            location["vpn_provider"] = None
            import random

            location["lat"] = location["lat"] + random.uniform(-0.5, 0.5)
            location["lon"] = location["lon"] + random.uniform(-0.5, 0.5)
            GEOIP_CACHE[ip] = location
            return location
        return None

    try:
        response = requests.get(
            f"http://ip-api.com/json/{ip}?fields=status,country,city,lat,lon,isp,as,query,proxy,hosting",
            timeout=2,
        )
        if response.status_code == 200:
            data = response.json()
            if data.get("status") == "success":
                isp = data.get("isp", "Unknown")
                asn = data.get("as", "Unknown")
                is_proxy = data.get("proxy", False)
                is_hosting = data.get("hosting", False)

                # Enhanced multi-layer VPN detection
                vpn_info = detect_vpn(ip, isp, asn)

                # If ip-api flags as proxy but our detector missed it
                if not vpn_info["is_vpn"] and is_proxy:
                    vpn_info = {
                        "is_vpn": True,
                        "provider": f"Proxy/VPN ({isp})",
                        "method": "ip-api-proxy",
                    }
                    VPN_CACHE[f"{ip}_{isp}_{asn}"] = vpn_info

                location = {
                    "ip": ip,
                    "country": data.get("country", "Unknown"),
                    "city": data.get("city", "Unknown"),
                    "lat": data.get("lat", 0),
                    "lon": data.get("lon", 0),
                    "isp": isp,
                    "asn": asn,
                    "is_vpn": vpn_info["is_vpn"],
                    "vpn_provider": vpn_info.get("provider"),
                    "vpn_method": vpn_info.get("method"),
                    "is_hosting": is_hosting,
                }
                GEOIP_CACHE[ip] = location
                return location
    except Exception as e:
        print(f"[WARN] Error getting location for {ip}: {e}")

    return None


# ============================================================================
# LIVE PACKET CAPTURE (FROM PACKETFLOW)
# ============================================================================


def packet_callback(packet):
    """Process captured packets in real-time (headers only for performance)"""
    global live_stats, captured_packets

    # Store packet headers only (payload ignored for performance)
    captured_packets.append(packet)

    # Debug: print first packet captured
    if live_stats["total_packets"] == 0:
        print("[SUCCESS] First packet captured! Capture is working.")

    if IP in packet:
        src_ip = packet[IP].src
        dst_ip = packet[IP].dst
        protocol = "TCP" if TCP in packet else "UDP" if UDP in packet else "OTHER"
        packet_size = len(packet)

        # Update enhanced stats
        live_stats["total_packets"] += 1
        live_stats["total_bytes"] += packet_size
        live_stats["unique_ips"].add(src_ip)
        live_stats["unique_ips"].add(dst_ip)
        live_stats["unique_src_ips"].add(src_ip)
        live_stats["unique_dst_ips"].add(dst_ip)
        live_stats["protocols"][protocol] += 1
        live_stats["top_talkers"][src_ip] += packet_size

        if protocol == "TCP":
            live_stats["tcp_packets"] += 1
            src_port = packet[TCP].sport
            dst_port = packet[TCP].dport
            flags = packet[TCP].flags
            seq = packet[TCP].seq
            ack = packet[TCP].ack
            live_stats["ports"][dst_port] += 1
        elif protocol == "UDP":
            live_stats["udp_packets"] += 1
            src_port = packet[UDP].sport
            dst_port = packet[UDP].dport
            flags = None
            seq = None
            ack = None
            live_stats["ports"][dst_port] += 1
        else:
            return

        # Create connection key
        conn_key = f"{src_ip}:{src_port}->{dst_ip}:{dst_port}"
        if conn_key not in live_stats["connections"]:
            live_stats["connections"][conn_key] = 0
        live_stats["connections"][conn_key] += 1

        # Get geolocation
        src_loc = get_ip_location_live(src_ip)
        dst_loc = get_ip_location_live(dst_ip)

        # Only process if both locations are valid
        if src_loc and dst_loc:
            # Check for VPN usage
            vpn_detected = False

            if src_loc.get("is_vpn"):
                vpn_detected = True
                live_stats["vpn_ips"].add(src_ip)
                vpn_ips.add(src_ip)
                if src_ip not in live_stats["vpn_details"]:
                    live_stats["vpn_details"][src_ip] = {
                        "ip": src_ip,
                        "provider": src_loc.get("vpn_provider", "Unknown"),
                        "isp": src_loc.get("isp", "Unknown"),
                        "country": src_loc.get("country", "Unknown"),
                        "city": src_loc.get("city", "Unknown"),
                        "direction": "source",
                        "peer_ip": dst_ip,
                        "method": src_loc.get("vpn_method", "keyword"),
                    }
                    print(
                        f"[VPN-ALERT] Source IP {src_ip} using {src_loc.get('vpn_provider')} (via {src_loc.get('vpn_method', 'keyword')})"
                    )

            if dst_loc.get("is_vpn"):
                vpn_detected = True
                live_stats["vpn_ips"].add(dst_ip)
                vpn_ips.add(dst_ip)
                if dst_ip not in live_stats["vpn_details"]:
                    live_stats["vpn_details"][dst_ip] = {
                        "ip": dst_ip,
                        "provider": dst_loc.get("vpn_provider", "Unknown"),
                        "isp": dst_loc.get("isp", "Unknown"),
                        "country": dst_loc.get("country", "Unknown"),
                        "city": dst_loc.get("city", "Unknown"),
                        "direction": "destination",
                        "peer_ip": src_ip,
                        "method": dst_loc.get("vpn_method", "keyword"),
                    }
                    print(
                        f"[VPN-ALERT] Destination IP {dst_ip} using {dst_loc.get('vpn_provider')} (via {dst_loc.get('vpn_method', 'keyword')})"
                    )

            packet_data = {
                "timestamp": time.time(),
                "src_ip": src_ip,
                "dst_ip": dst_ip,
                "src_port": src_port,
                "dst_port": dst_port,
                "protocol": protocol,
                "src_location": src_loc,
                "dst_location": dst_loc,
                "size": packet_size,
                "flags": str(flags) if flags else None,
                "seq": seq,
                "ack": ack,
                "ttl": packet[IP].ttl if IP in packet else None,
                "id": packet[IP].id if IP in packet else None,
                "vpn_detected": vpn_detected,
            }

            packet_history.append(packet_data)

            # Emit to all connected clients via WebSocket
            socketio.emit("new_packet", packet_data)


# ============================================================================
# SWITCH MONITORING - Per-device VPN detection for all switch traffic
# ============================================================================


def is_internal_ip(ip_str):
    """Check if an IP belongs to the monitored internal subnet(s)"""
    if not SWITCH_SUBNET:
        # Default: treat all private IPs as internal
        return is_private_ip(ip_str)
    try:
        ip = ipaddress.ip_address(ip_str)
        subnet = ipaddress.ip_network(SWITCH_SUBNET, strict=False)
        return ip in subnet
    except ValueError:
        return False


def detect_vpn_protocol_heuristic(packet, src_port, dst_port, protocol):
    """Detect VPN usage by protocol/port heuristics (DPI-lite).
    This catches VPN traffic even before IP reputation lookups.
    """
    hints = []

    # Check known VPN ports
    for port in [src_port, dst_port]:
        if port in VPN_PROTOCOL_PORTS:
            # 443 is too common - only flag if combined with other signals
            if port != 443 and port != 53:
                hints.append({"port": port, "protocol_hint": VPN_PROTOCOL_PORTS[port]})
            elif port == 53 and protocol == "TCP":
                # DNS over TCP with large packets = possible DNS tunnel
                if len(packet) > 200:
                    hints.append(
                        {"port": port, "protocol_hint": "DNS Tunnel (suspicious)"}
                    )

    # WireGuard heuristic: UDP with specific packet sizes
    if protocol == "UDP" and dst_port >= 51820 and dst_port <= 51830:
        hints.append({"port": dst_port, "protocol_hint": "WireGuard"})

    # IPSec ESP: protocol number 50
    if IP in packet and packet[IP].proto == 50:
        hints.append({"port": 0, "protocol_hint": "IPSec ESP"})

    # IKE: UDP port 500 or 4500
    if protocol == "UDP" and dst_port in [500, 4500]:
        hints.append({"port": dst_port, "protocol_hint": VPN_PROTOCOL_PORTS[dst_port]})

    # OpenVPN heuristic: UDP/TCP 1194, or specific payload signature
    if dst_port == 1194 or src_port == 1194:
        hints.append({"port": 1194, "protocol_hint": "OpenVPN"})

    return hints


def switch_packet_callback(packet):
    """Process packets captured from switch mirror port.
    Tracks per-device activity and detects VPN usage per internal device.
    """
    global switch_devices, switch_vpn_alerts

    if IP not in packet:
        return

    src_ip = packet[IP].src
    dst_ip = packet[IP].dst
    protocol = "TCP" if TCP in packet else "UDP" if UDP in packet else "OTHER"
    packet_size = len(packet)
    now = time.time()

    if protocol == "TCP" and TCP in packet:
        src_port = packet[TCP].sport
        dst_port = packet[TCP].dport
    elif protocol == "UDP" and UDP in packet:
        src_port = packet[UDP].sport
        dst_port = packet[UDP].dport
    else:
        src_port = 0
        dst_port = 0

    # Determine which IP is internal (the monitored device)
    src_is_internal = is_internal_ip(src_ip)
    dst_is_internal = is_internal_ip(dst_ip)

    if not src_is_internal and not dst_is_internal:
        return  # Neither end is on our network - skip

    # Identify the internal device and the external endpoint
    if src_is_internal:
        internal_ip = src_ip
        external_ip = dst_ip
        direction = "outbound"
    else:
        internal_ip = dst_ip
        external_ip = src_ip
        direction = "inbound"

    # Skip if external IP is also internal (internal-to-internal traffic)
    if is_internal_ip(external_ip):
        # Still track device activity
        with switch_device_lock:
            if internal_ip not in switch_devices:
                switch_devices[internal_ip] = _new_device_entry(internal_ip, now)
            switch_devices[internal_ip]["last_seen"] = now
            switch_devices[internal_ip]["total_packets"] += 1
            switch_devices[internal_ip]["total_bytes"] += packet_size
            switch_devices[internal_ip]["internal_traffic_bytes"] += packet_size
        return

    # Update device entry
    with switch_device_lock:
        if internal_ip not in switch_devices:
            switch_devices[internal_ip] = _new_device_entry(internal_ip, now)

        dev = switch_devices[internal_ip]
        dev["last_seen"] = now
        dev["total_packets"] += 1
        dev["total_bytes"] += packet_size
        dev["protocols"][protocol] = dev["protocols"].get(protocol, 0) + 1

        # Track unique external IPs this device communicates with
        if external_ip not in dev["external_ips"]:
            dev["external_ips"][external_ip] = {
                "packets": 0,
                "bytes": 0,
                "first_seen": now,
            }
        dev["external_ips"][external_ip]["packets"] += 1
        dev["external_ips"][external_ip]["bytes"] += packet_size

    # --- VPN Detection for this device ---

    # 1. Protocol/port heuristics (instant, no network calls)
    vpn_hints = detect_vpn_protocol_heuristic(packet, src_port, dst_port, protocol)

    # 2. IP reputation check (uses cache, occasional API call)
    vpn_by_ip = False
    vpn_provider = None
    vpn_method = None

    # Only do expensive lookups for external IPs we haven't checked
    if not is_private_ip(external_ip):
        ext_loc = get_ip_location_live(external_ip)
        if ext_loc and ext_loc.get("is_vpn"):
            vpn_by_ip = True
            vpn_provider = ext_loc.get("vpn_provider", "Unknown VPN")
            vpn_method = ext_loc.get("vpn_method", "ip_lookup")

    # Combine heuristic + IP reputation results
    is_vpn_traffic = vpn_by_ip or len(vpn_hints) > 0

    if is_vpn_traffic:
        with switch_device_lock:
            dev = switch_devices[internal_ip]
            dev["vpn_detected"] = True
            dev["vpn_packet_count"] = dev.get("vpn_packet_count", 0) + 1
            dev["vpn_bytes"] = dev.get("vpn_bytes", 0) + packet_size

            # Determine provider
            if vpn_by_ip and vpn_provider:
                provider = vpn_provider
                method = vpn_method
            elif vpn_hints:
                provider = vpn_hints[0]["protocol_hint"]
                method = f"port_{vpn_hints[0]['port']}"
            else:
                provider = "Unknown VPN"
                method = "heuristic"

            # Track VPN connections per device
            vpn_conn_key = f"{external_ip}:{dst_port}"
            if "vpn_connections" not in dev:
                dev["vpn_connections"] = {}
            if vpn_conn_key not in dev["vpn_connections"]:
                dev["vpn_connections"][vpn_conn_key] = {
                    "external_ip": external_ip,
                    "port": dst_port,
                    "provider": provider,
                    "method": method,
                    "first_seen": now,
                    "last_seen": now,
                    "packets": 0,
                    "bytes": 0,
                }

                # New VPN connection detected - create alert!
                alert = {
                    "id": len(switch_vpn_alerts) + 1,
                    "timestamp": now,
                    "timestamp_str": datetime.fromtimestamp(now).strftime(
                        "%Y-%m-%d %H:%M:%S"
                    ),
                    "device_ip": internal_ip,
                    "vpn_server_ip": external_ip,
                    "port": dst_port,
                    "protocol": protocol,
                    "provider": provider,
                    "method": method,
                    "direction": direction,
                    "severity": "HIGH" if vpn_by_ip else "MEDIUM",
                }
                switch_vpn_alerts.append(alert)

                # Keep only last 500 alerts
                if len(switch_vpn_alerts) > 500:
                    switch_vpn_alerts = switch_vpn_alerts[-500:]

                print(
                    f"[SWITCH-VPN-ALERT] Device {internal_ip} -> VPN server {external_ip}:{dst_port} ({provider}) via {method}"
                )

                # Emit real-time alert via WebSocket
                socketio.emit("switch_vpn_alert", alert)

            dev["vpn_connections"][vpn_conn_key]["last_seen"] = now
            dev["vpn_connections"][vpn_conn_key]["packets"] += 1
            dev["vpn_connections"][vpn_conn_key]["bytes"] += packet_size

    # Emit live-capture-style packet for real-time map + packet table (every packet)
    if not is_private_ip(external_ip):
        ext_loc = GEOIP_CACHE.get(external_ip)
        if ext_loc and ext_loc.get("lat"):
            user_loc = get_user_public_location()
            if user_loc:
                import random as _rnd

                # Build location objects matching live capture shape
                internal_loc = {
                    "lat": user_loc["lat"] + _rnd.uniform(-0.3, 0.3),
                    "lon": user_loc["lon"] + _rnd.uniform(-0.3, 0.3),
                    "ip": internal_ip,
                    "city": user_loc.get("city", ""),
                    "country": user_loc.get("country", ""),
                    "isp": "Internal",
                    "is_vpn": False,
                }
                external_loc = {
                    "lat": ext_loc["lat"],
                    "lon": ext_loc["lon"],
                    "ip": external_ip,
                    "city": ext_loc.get("city", ""),
                    "country": ext_loc.get("country", ""),
                    "isp": ext_loc.get("isp", ""),
                    "is_vpn": ext_loc.get("is_vpn", False),
                    "vpn_provider": ext_loc.get("vpn_provider"),
                }

                if direction == "outbound":
                    src_loc_data = internal_loc
                    dst_loc_data = external_loc
                else:
                    src_loc_data = external_loc
                    dst_loc_data = internal_loc

                packet_data = {
                    "timestamp": now,
                    "src_ip": src_ip,
                    "dst_ip": dst_ip,
                    "src_port": src_port,
                    "dst_port": dst_port,
                    "protocol": protocol,
                    "src_location": src_loc_data,
                    "dst_location": dst_loc_data,
                    "size": packet_size,
                    "flags": (str(packet[TCP].flags) if TCP in packet else None),
                    "seq": packet[TCP].seq if TCP in packet else None,
                    "ack": packet[TCP].ack if TCP in packet else None,
                    "ttl": packet[IP].ttl,
                    "id": packet[IP].id,
                    "vpn_detected": is_vpn_traffic,
                    "device_ip": internal_ip,
                    "direction": direction,
                }

                socketio.emit("switch_new_packet", packet_data)

    # Emit device update periodically (every 50 packets per device to reduce noise)
    with switch_device_lock:
        dev = switch_devices[internal_ip]
        if dev["total_packets"] % 50 == 0:
            socketio.emit("switch_device_update", _sanitize_device(internal_ip, dev))


def _new_device_entry(ip, now):
    """Create a new device tracking entry"""
    return {
        "ip": ip,
        "first_seen": now,
        "last_seen": now,
        "total_packets": 0,
        "total_bytes": 0,
        "internal_traffic_bytes": 0,
        "protocols": {},
        "external_ips": {},
        "vpn_detected": False,
        "vpn_packet_count": 0,
        "vpn_bytes": 0,
        "vpn_connections": {},
    }


def _sanitize_device(ip, dev):
    """Create a JSON-safe summary of a device for API/WebSocket responses"""
    vpn_conns = []
    for key, conn_info in dev.get("vpn_connections", {}).items():
        # Get geo for VPN server IP
        geo = GEOIP_CACHE.get(conn_info["external_ip"])
        vpn_conns.append(
            {
                "external_ip": conn_info["external_ip"],
                "port": conn_info["port"],
                "provider": conn_info["provider"],
                "method": conn_info["method"],
                "packets": conn_info["packets"],
                "bytes": conn_info["bytes"],
                "first_seen": conn_info["first_seen"],
                "last_seen": conn_info["last_seen"],
                "geo": (
                    {
                        "lat": geo["lat"],
                        "lon": geo["lon"],
                        "city": geo.get("city", ""),
                        "country": geo.get("country", ""),
                        "isp": geo.get("isp", ""),
                    }
                    if geo and geo.get("lat")
                    else None
                ),
            }
        )

    # Collect geo for top external IPs
    ext_geo_samples = []
    for ext_ip, info in list(dev.get("external_ips", {}).items())[:30]:
        geo = GEOIP_CACHE.get(ext_ip)
        if geo and geo.get("lat"):
            ext_geo_samples.append(
                {
                    "ip": ext_ip,
                    "lat": geo["lat"],
                    "lon": geo["lon"],
                    "city": geo.get("city", ""),
                    "country": geo.get("country", ""),
                    "isp": geo.get("isp", ""),
                    "is_vpn": geo.get("is_vpn", False),
                    "vpn_provider": geo.get("vpn_provider"),
                    "packets": info["packets"],
                    "bytes": info["bytes"],
                }
            )

    return {
        "ip": ip,
        "first_seen": dev["first_seen"],
        "last_seen": dev["last_seen"],
        "total_packets": dev["total_packets"],
        "total_bytes": dev["total_bytes"],
        "internal_traffic_bytes": dev.get("internal_traffic_bytes", 0),
        "protocols": dev["protocols"],
        "external_ip_count": len(dev["external_ips"]),
        "vpn_detected": dev["vpn_detected"],
        "vpn_packet_count": dev.get("vpn_packet_count", 0),
        "vpn_bytes": dev.get("vpn_bytes", 0),
        "vpn_connections": vpn_conns,
        "ext_geo": ext_geo_samples,
    }


def start_switch_monitor():
    """Start switch monitoring in a separate thread"""
    global SWITCH_MONITOR_RUNNING, switch_devices, switch_vpn_alerts

    SWITCH_MONITOR_RUNNING = True
    switch_devices = {}
    switch_vpn_alerts = []

    iface = SWITCH_INTERFACE
    print(f"[SWITCH] Starting switch monitor on interface: {iface or 'ALL'}")
    print(f"[SWITCH] Monitoring subnet: {SWITCH_SUBNET or 'all private ranges'}")
    print(f"[SWITCH] Promiscuous mode enabled for switch traffic capture")
    print(f"[SWITCH] Make sure port mirroring (SPAN) is configured on your switch!")

    # Initialize VPN databases
    if not VPN_IP_RANGES_LOADED:
        try:
            download_vpn_ip_lists()
        except:
            pass

    try:
        try:
            sniff(
                iface=iface,
                prn=switch_packet_callback,
                filter="ip and (tcp or udp)",
                store=False,
                snaplen=CAPTURE_SNAPLEN,
                stop_filter=lambda x: not SWITCH_MONITOR_RUNNING,
            )
        except TypeError:
            print("[WARN] snaplen not supported, capturing full packets")
            sniff(
                iface=iface,
                prn=switch_packet_callback,
                filter="ip and (tcp or udp)",
                store=False,
                stop_filter=lambda x: not SWITCH_MONITOR_RUNNING,
            )
    except PermissionError:
        print("[ERROR] Permission denied! Run as Administrator for switch monitoring")
        SWITCH_MONITOR_RUNNING = False
    except Exception as e:
        print(f"[ERROR] Switch monitoring error: {e}")
        SWITCH_MONITOR_RUNNING = False


def start_capture():
    """Start packet capture in a separate thread"""
    global capture_running, capture_session_name, captured_packets
    capture_running = True
    live_stats["start_time"] = time.time()

    # Generate session name
    capture_session_name = f"live_capture_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
    captured_packets = []  # Clear previous packets

    print(
        f"[INFO] Starting live packet capture on interface: {CAPTURE_INTERFACE or 'ALL'}"
    )
    print(f"[INFO] Session name: {capture_session_name}")

    # Initialize user location
    get_user_public_location()

    print(
        f"[INFO] Capturing headers only ({CAPTURE_SNAPLEN} bytes) for optimal performance"
    )
    print("[INFO] Waiting for packets... (Make sure you're running as Administrator)")

    try:
        # Try with snaplen first
        try:
            sniff(
                iface=CAPTURE_INTERFACE,
                prn=packet_callback,
                filter="ip and (tcp or udp)",
                store=False,
                snaplen=CAPTURE_SNAPLEN,  # Capture only headers (Ethernet + IP + TCP/UDP), ignore payload
                stop_filter=lambda x: not capture_running,
            )
        except TypeError:
            # snaplen not supported on this platform, fallback without it
            print("[WARN] snaplen parameter not supported, capturing full packets")
            sniff(
                iface=CAPTURE_INTERFACE,
                prn=packet_callback,
                filter="ip and (tcp or udp)",
                store=False,
                stop_filter=lambda x: not capture_running,
            )
    except PermissionError:
        print(
            "[ERROR] Permission denied! Run as Administrator (Windows) or with sudo (Linux)"
        )
        capture_running = False
    except Exception as e:
        print(f"[ERROR] Error during packet capture: {e}")
        print("[ERROR] Make sure you have Npcap installed: https://npcap.com/")
        capture_running = False


