@app.route("/api/switch/interfaces")
def get_switch_interfaces():
    """List available network interfaces for switch monitoring.
    Works on Windows, Linux, and macOS by using platform-specific Scapy APIs.
    """
    import platform

    result = []

    try:
        if platform.system() == "Windows":
            from scapy.arch.windows import get_windows_if_list

            ifaces = get_windows_if_list()

            # Keywords to skip (virtual/filter/tunneling adapters)
            skip_keywords = [
                "WFP",
                "Filter",
                "Pseudo",
                "Tunneling",
                "6to4",
                "SSTP",
                "IKEv2",
                "L2TP",
                "PPTP",
                "PPPOE",
                "WAN Miniport",
                "QoS Packet Scheduler",
                "Npcap Packet Driver",
                "Kernel Debug",
                "Wi-Fi Direct",
                "Bluetooth",
                "Microsoft IP-HTTPS",
                "Teredo",
            ]

            for iface in ifaces:
                name = iface.get("name", "")
                desc = iface.get("description", "")
                ips = iface.get("ips", [])
                combined = f"{name} {desc}"

                if any(skip.lower() in combined.lower() for skip in skip_keywords):
                    continue

                ipv4s = [ip for ip in ips if "." in ip and not ip.startswith("169.254")]
                is_ethernet = any(
                    kw in combined.lower()
                    for kw in [
                        "ethernet",
                        "realtek",
                        "intel i2",
                        "broadcom",
                        "usb gbe",
                        "gigabit",
                    ]
                )
                is_wifi = any(
                    kw in combined.lower()
                    for kw in ["wi-fi", "wifi", "wireless", "wlan", "killer"]
                )

                if not ipv4s and not is_ethernet and not is_wifi:
                    continue

                result.append(
                    {
                        "name": name,
                        "description": desc,
                        "ips": ips,
                        "ipv4": ipv4s,
                        "is_ethernet": is_ethernet,
                        "is_wifi": is_wifi,
                    }
                )

        else:
            # Linux / macOS: use generic Scapy interface list + netifaces if available
            from scapy.all import get_if_list

            ifaces = get_if_list()

            # Skip loopback and virtual interfaces on Linux/macOS
            skip_prefixes = ("lo", "docker", "br-", "veth", "virbr", "vmnet")

            for iface_name in ifaces:
                if iface_name.startswith(skip_prefixes):
                    continue

                is_ethernet = any(
                    kw in iface_name.lower() for kw in ["eth", "en", "enp", "ens"]
                )
                is_wifi = any(kw in iface_name.lower() for kw in ["wl", "wlan", "wifi"])

                # Try to get IP addresses via socket
                ipv4s = []
                try:
                    import fcntl
                    import struct

                    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                    ip_addr = socket.inet_ntoa(
                        fcntl.ioctl(
                            s.fileno(),
                            0x8915,  # SIOCGIFADDR
                            struct.pack("256s", iface_name[:15].encode("utf-8")),
                        )[20:24]
                    )
                    if not ip_addr.startswith("169.254"):
                        ipv4s.append(ip_addr)
                except Exception:
                    pass

                result.append(
                    {
                        "name": iface_name,
                        "description": iface_name,
                        "ips": ipv4s,
                        "ipv4": ipv4s,
                        "is_ethernet": is_ethernet,
                        "is_wifi": is_wifi,
                    }
                )

        # Sort: ethernet first, then wifi, then others
        result.sort(
            key=lambda x: (not x["is_ethernet"], not x.get("is_wifi", False), x["name"])
        )

        return jsonify({"interfaces": result})

    except Exception as e:
        # Final fallback: basic interface list
        try:
            from scapy.all import get_if_list

            ifaces = get_if_list()
            return jsonify(
                {
                    "interfaces": [
                        {
                            "name": i,
                            "description": i,
                            "ips": [],
                            "ipv4": [],
                            "is_ethernet": False,
                            "is_wifi": False,
                        }
                        for i in ifaces
                    ]
                }
            )
        except Exception:
            return jsonify({"error": str(e)}), 500


@app.route("/api/switch/start", methods=["POST"])
def start_switch_monitoring():
    """Start switch monitoring mode.
    Body: { "interface": "Ethernet", "subnet": "172.16.0.0/16" }
    """
    global SWITCH_MONITOR_MODE, SWITCH_INTERFACE, SWITCH_SUBNET, SWITCH_MONITOR_RUNNING
    global GEOIP_CACHE, VPN_CACHE, vpn_ips

    if SWITCH_MONITOR_RUNNING:
        return jsonify(
            {"status": "already_running", "message": "Switch monitoring already active"}
        )

    data = request.json or {}
    iface = data.get("interface")
    subnet = data.get("subnet", "172.16.0.0/16")

    # Validate subnet
    try:
        ipaddress.ip_network(subnet, strict=False)
    except ValueError as e:
        return jsonify({"error": f"Invalid subnet: {e}"}), 400

    SWITCH_INTERFACE = iface
    SWITCH_SUBNET = subnet
    SWITCH_MONITOR_MODE = True

    # Clear caches for fresh detection
    GEOIP_CACHE.clear()
    VPN_CACHE.clear()
    vpn_ips.clear()

    # Start monitoring in background thread
    monitor_thread = threading.Thread(target=start_switch_monitor, daemon=True)
    monitor_thread.start()

    return jsonify(
        {
            "status": "started",
            "message": f"Switch monitoring started on {iface or 'all interfaces'}",
            "interface": iface,
            "subnet": subnet,
        }
    )


@app.route("/api/switch/stop")
def stop_switch_monitoring():
    """Stop switch monitoring"""
    global SWITCH_MONITOR_RUNNING, SWITCH_MONITOR_MODE

    SWITCH_MONITOR_RUNNING = False
    SWITCH_MONITOR_MODE = False

    # Summary
    device_count = len(switch_devices)
    vpn_device_count = sum(1 for d in switch_devices.values() if d.get("vpn_detected"))

    return jsonify(
        {
            "status": "stopped",
            "message": "Switch monitoring stopped",
            "devices_seen": device_count,
            "vpn_devices_detected": vpn_device_count,
            "total_alerts": len(switch_vpn_alerts),
        }
    )


@app.route("/api/switch/reset")
def reset_switch_data():
    """Reset all switch monitoring data (devices, alerts, caches)"""
    global switch_devices, switch_vpn_alerts, SWITCH_MONITOR_RUNNING, SWITCH_MONITOR_MODE

    was_running = SWITCH_MONITOR_RUNNING
    SWITCH_MONITOR_RUNNING = False
    SWITCH_MONITOR_MODE = False

    with switch_device_lock:
        old_devices = len(switch_devices)
        old_alerts = len(switch_vpn_alerts)
        switch_devices = {}
        switch_vpn_alerts = []

    return jsonify(
        {
            "status": "reset",
            "message": "All switch data cleared",
            "cleared_devices": old_devices,
            "cleared_alerts": old_alerts,
            "was_running": was_running,
        }
    )


@app.route("/api/switch/status")
def get_switch_status():
    """Get current switch monitoring status"""
    device_count = len(switch_devices)
    vpn_device_count = sum(1 for d in switch_devices.values() if d.get("vpn_detected"))
    total_packets = sum(d["total_packets"] for d in switch_devices.values())
    total_bytes = sum(d["total_bytes"] for d in switch_devices.values())

    return jsonify(
        {
            "monitoring": SWITCH_MONITOR_RUNNING,
            "interface": SWITCH_INTERFACE,
            "subnet": SWITCH_SUBNET,
            "devices_count": device_count,
            "vpn_devices_count": vpn_device_count,
            "total_packets": total_packets,
            "total_bytes": total_bytes,
            "alert_count": len(switch_vpn_alerts),
        }
    )


@app.route("/api/switch/devices")
def get_switch_devices():
    """Get all devices seen on the switch with their VPN status"""
    sort_by = request.args.get("sort", "last_seen")  # last_seen, bytes, vpn
    vpn_only = request.args.get("vpn_only", "false").lower() == "true"

    with switch_device_lock:
        devices = []
        for ip, dev in switch_devices.items():
            if vpn_only and not dev.get("vpn_detected"):
                continue
            devices.append(_sanitize_device(ip, dev))

    # Sort
    if sort_by == "bytes":
        devices.sort(key=lambda d: d["total_bytes"], reverse=True)
    elif sort_by == "vpn":
        devices.sort(
            key=lambda d: (d["vpn_detected"], d["vpn_packet_count"]), reverse=True
        )
    elif sort_by == "packets":
        devices.sort(key=lambda d: d["total_packets"], reverse=True)
    else:
        devices.sort(key=lambda d: d["last_seen"], reverse=True)

    return jsonify(
        {
            "devices": devices,
            "total": len(devices),
            "monitoring": SWITCH_MONITOR_RUNNING,
        }
    )


@app.route("/api/switch/vpn_alerts")
def get_switch_vpn_alerts():
    """Get VPN detection alerts from switch monitoring"""
    limit = int(request.args.get("limit", 50))
    severity = request.args.get("severity")  # HIGH, MEDIUM

    alerts = switch_vpn_alerts.copy()

    if severity:
        alerts = [a for a in alerts if a.get("severity") == severity]

    # Most recent first
    alerts = list(reversed(alerts[-limit:]))

    # Summary stats
    unique_vpn_devices = set(a["device_ip"] for a in switch_vpn_alerts)
    unique_vpn_servers = set(a["vpn_server_ip"] for a in switch_vpn_alerts)
    provider_counts = {}
    for a in switch_vpn_alerts:
        p = a.get("provider", "Unknown")
        provider_counts[p] = provider_counts.get(p, 0) + 1

    return jsonify(
        {
            "alerts": alerts,
            "total_alerts": len(switch_vpn_alerts),
            "unique_vpn_devices": len(unique_vpn_devices),
            "unique_vpn_servers": len(unique_vpn_servers),
            "provider_summary": provider_counts,
            "monitoring": SWITCH_MONITOR_RUNNING,
        }
    )


@app.route("/api/switch/map_data")
def get_switch_map_data():
    """Get geo-enriched data for plotting switch traffic on the map"""
    with switch_device_lock:
        map_nodes = []  # Unique geo points
        map_links = []  # Lines between device (local) and external IPs
        seen_coords = {}
        user_loc = get_user_public_location()

        for ip, dev in switch_devices.items():
            for ext_ip, info in list(dev.get("external_ips", {}).items())[:15]:
                geo = GEOIP_CACHE.get(ext_ip)
                if not geo or not geo.get("lat"):
                    continue
                coord_key = f"{round(geo['lat'],2)},{round(geo['lon'],2)}"
                is_vpn = geo.get("is_vpn", False)
                if coord_key not in seen_coords:
                    seen_coords[coord_key] = {
                        "lat": geo["lat"],
                        "lon": geo["lon"],
                        "ip": ext_ip,
                        "city": geo.get("city", ""),
                        "country": geo.get("country", ""),
                        "isp": geo.get("isp", ""),
                        "is_vpn": is_vpn,
                        "vpn_provider": geo.get("vpn_provider"),
                        "packets": info["packets"],
                        "bytes": info["bytes"],
                        "device_ip": ip,
                    }
                else:
                    seen_coords[coord_key]["packets"] += info["packets"]
                    seen_coords[coord_key]["bytes"] += info["bytes"]
                    if is_vpn:
                        seen_coords[coord_key]["is_vpn"] = True
                        seen_coords[coord_key]["vpn_provider"] = geo.get("vpn_provider")

                # Link from device to ext
                if user_loc:
                    import random as _rnd

                    map_links.append(
                        {
                            "src_lat": user_loc["lat"] + _rnd.uniform(-0.2, 0.2),
                            "src_lon": user_loc["lon"] + _rnd.uniform(-0.2, 0.2),
                            "dst_lat": geo["lat"],
                            "dst_lon": geo["lon"],
                            "device_ip": ip,
                            "external_ip": ext_ip,
                            "is_vpn": is_vpn,
                            "packets": info["packets"],
                        }
                    )

        map_nodes = list(seen_coords.values())

    return jsonify(
        {
            "nodes": map_nodes,
            "links": map_links,
            "user_location": user_loc,
            "device_count": len(switch_devices),
        }
    )


@app.route("/api/switch/device/<device_ip>")
def get_switch_device_detail(device_ip):
    """Get detailed info for a specific device on the switch"""
    with switch_device_lock:
        if device_ip not in switch_devices:
            return jsonify({"error": f"Device {device_ip} not found"}), 404

        dev = switch_devices[device_ip]
        detail = _sanitize_device(device_ip, dev)

        # Add top external IPs
        ext_ips = sorted(
            dev["external_ips"].items(), key=lambda x: x[1]["bytes"], reverse=True
        )[:20]
        detail["top_external_ips"] = [
            {
                "ip": ip,
                "packets": info["packets"],
                "bytes": info["bytes"],
                "first_seen": info["first_seen"],
            }
            for ip, info in ext_ips
        ]

        # Add device-specific alerts
        detail["alerts"] = [
            a for a in switch_vpn_alerts if a["device_ip"] == device_ip
        ][-20:]

    return jsonify(detail)


