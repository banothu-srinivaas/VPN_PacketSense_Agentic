# ============================================================================
# VPN IP LIST DOWNLOADER (X4BNet public GitHub lists)
# ============================================================================

import ipaddress


def download_vpn_ip_lists():
    """Download VPN IP ranges from X4BNet public GitHub repository.
    Source: https://github.com/X4BNet/lists_vpn (updated daily)
    This is a widely-used public database of known VPN IP ranges.
    """
    global VPN_IP_RANGES_V4, VPN_IP_RANGES_LOADED

    vpn_lists_dir = Path("data/vpn_lists")
    vpn_lists_dir.mkdir(parents=True, exist_ok=True)

    # X4BNet VPN IP list URLs (public, updated daily)
    sources = {
        "x4bnet_ipv4": "https://raw.githubusercontent.com/X4BNet/lists_vpn/main/output/vpn/ipv4.txt",
    }

    loaded_networks = []
    cache_max_age = 86400  # Re-download after 24 hours

    for name, url in sources.items():
        cache_file = vpn_lists_dir / f"{name}.txt"
        should_download = True

        # Check if cached file exists and is recent
        if cache_file.exists():
            file_age = time.time() - cache_file.stat().st_mtime
            if file_age < cache_max_age:
                should_download = False
                print(f"[VPN-DB] Using cached {name} list (age: {int(file_age/3600)}h)")

        if should_download:
            try:
                print(f"[VPN-DB] Downloading {name} from X4BNet...")
                resp = requests.get(url, timeout=15)
                if resp.status_code == 200:
                    cache_file.write_text(resp.text)
                    print(
                        f"[VPN-DB] Downloaded {name}: {len(resp.text.splitlines())} entries"
                    )
                else:
                    print(
                        f"[VPN-DB] Failed to download {name}: HTTP {resp.status_code}"
                    )
                    if not cache_file.exists():
                        continue
            except Exception as e:
                print(f"[VPN-DB] Download error for {name}: {e}")
                if not cache_file.exists():
                    continue

        # Parse the IP list
        try:
            lines = cache_file.read_text().strip().splitlines()
            for line in lines:
                line = line.strip()
                if line and not line.startswith("#"):
                    try:
                        network = ipaddress.ip_network(line, strict=False)
                        loaded_networks.append(network)
                    except ValueError:
                        pass
            print(f"[VPN-DB] Loaded {len(loaded_networks)} networks from {name}")
        except Exception as e:
            print(f"[VPN-DB] Parse error for {name}: {e}")

    # Also load Tor exit nodes from dan.me.uk (public list)
    tor_cache = vpn_lists_dir / "tor_exit_nodes.txt"
    should_download_tor = True
    if tor_cache.exists():
        file_age = time.time() - tor_cache.stat().st_mtime
        if file_age < cache_max_age:
            should_download_tor = False

    if should_download_tor:
        try:
            print("[VPN-DB] Downloading Tor exit node list...")
            resp = requests.get("https://www.dan.me.uk/torlist/?exit", timeout=15)
            if resp.status_code == 200:
                tor_cache.write_text(resp.text)
                print(
                    f"[VPN-DB] Downloaded Tor exit nodes: {len(resp.text.splitlines())} entries"
                )
        except Exception as e:
            print(f"[VPN-DB] Tor list download error: {e}")

    if tor_cache.exists():
        try:
            tor_ips = set()
            for line in tor_cache.read_text().strip().splitlines():
                line = line.strip()
                if line and not line.startswith("#"):
                    try:
                        # Single IPs - convert to /32 network
                        network = ipaddress.ip_network(f"{line}/32", strict=False)
                        loaded_networks.append(network)
                        tor_ips.add(line)
                    except ValueError:
                        pass
            print(f"[VPN-DB] Loaded {len(tor_ips)} Tor exit nodes")
        except Exception as e:
            print(f"[VPN-DB] Tor list parse error: {e}")

    VPN_IP_RANGES_V4 = loaded_networks
    VPN_IP_RANGES_LOADED = True
    print(f"[VPN-DB] Total VPN/Proxy IP networks loaded: {len(VPN_IP_RANGES_V4)}")


def check_ip_in_vpn_ranges(ip_str):
    """Check if an IP is in the downloaded VPN IP range databases.
    Uses binary search on sorted CIDR ranges for efficiency.
    """
    if not VPN_IP_RANGES_LOADED or not VPN_IP_RANGES_V4:
        return False
    try:
        ip = ipaddress.ip_address(ip_str)
        for network in VPN_IP_RANGES_V4:
            if ip in network:
                return True
    except ValueError:
        pass
    return False


def check_vpnapi_io(ip_str):
    """Query vpnapi.io free public API for VPN/proxy detection.
    Free tier: 1000 queries/day. No key needed for basic use.
    API docs: https://vpnapi.io/
    """
    try:
        url = f"https://vpnapi.io/api/{ip_str}"
        if VPNAPI_IO_KEY:
            url += f"?key={VPNAPI_IO_KEY}"
        resp = requests.get(url, timeout=3)
        if resp.status_code == 200:
            data = resp.json()
            security = data.get("security", {})
            if security.get("vpn") or security.get("proxy") or security.get("tor"):
                provider = "Unknown VPN"
                if security.get("tor"):
                    provider = "Tor Network"
                elif security.get("proxy"):
                    provider = "Proxy Service"
                else:
                    # Try to extract provider from network info
                    network = data.get("network", {})
                    provider = network.get(
                        "autonomous_system_organization", "VPN Service"
                    )
                return {"is_vpn": True, "provider": provider, "method": "vpnapi.io"}
    except Exception as e:
        pass  # Silently fail - this is a supplementary check
    return None


