def get_llm():
    """Initialize and return LLM client"""
    global llm_client
    if llm_client is None:
        # Check for provider preference (default to ollama for local setup)
        provider = os.getenv("LLM_PROVIDER", "ollama").lower()

        # Get API key based on provider
        if provider == "ollama":
            api_key = None  # Ollama doesn't need API key
        elif provider == "openrouter":
            api_key = os.getenv("OPENROUTER_API_KEY")
        elif provider == "anthropic":
            api_key = os.getenv("ANTHROPIC_API_KEY")
        elif provider == "openai":
            api_key = os.getenv("OPENAI_API_KEY")
        elif provider == "gemini":
            api_key = os.getenv("GEMINI_API_KEY")
        else:
            # Fallback: try to find any available API key
            api_key = (
                os.getenv("OPENROUTER_API_KEY")
                or os.getenv("ANTHROPIC_API_KEY")
                or os.getenv("OPENAI_API_KEY")
            )
            provider = "openrouter" if os.getenv("OPENROUTER_API_KEY") else "anthropic"

        try:
            llm_client = LLMClient(api_key=api_key, provider=provider)
            print(f"[INFO] Initialized LLM client with provider: {provider}")
        except Exception as e:
            print(f"[WARN] LLM Client init failed: {e}")
            llm_client = None
    return llm_client


# ============================================================================
# DUCKDB / PARQUET FUNCTIONS (FROM 5G-PACKETSENSE)
# ============================================================================


def detect_columns(conn):
    """Detect column schema (live capture uses simple schema: src_ip, dst_ip, etc.)"""
    global COLS
    try:
        schema = conn.execute("DESCRIBE packets").fetchall()
        cols = [c[0] for c in schema]
        print(f"[INFO] Detected columns: {cols}")
        # Live capture schema is already set in COLS by default
    except Exception as e:
        print(f"[WARN] Column detection failed: {e}")


def load_parquet(path: str):
    """Load Parquet file into DuckDB"""
    global conn, parquet_path
    parquet_path = path
    conn = duckdb.connect(":memory:")
    conn.execute(f"CREATE TABLE packets AS SELECT * FROM read_parquet('{path}')")

    # Verify count
    try:
        count = conn.execute("SELECT COUNT(*) FROM packets").fetchone()[0]
        print(f"[OK] Loaded {path} into DuckDB (Rows: {count})")
    except:
        print(f"[OK] Loaded {path} into DuckDB")

    detect_columns(conn)


# ============================================================================
# GEOLOCATION FUNCTIONS
# ============================================================================


def get_geolocation(ip: str) -> dict:
    """Get geolocation for IP address - returns None for unknown locations"""
    # Try cache first
    if ip in GEOIP_CACHE:
        return GEOIP_CACHE[ip].copy()

    # Handle private IPs - use user's location
    if is_private_ip(ip):
        fallback = get_user_public_location()
        if fallback:
            import random

            location = {
                "ip": ip,
                "lat": fallback["lat"] + random.uniform(-0.5, 0.5),
                "lon": fallback["lon"] + random.uniform(-0.5, 0.5),
                "country": fallback["country"],
                "city": "Local Network",
                "isp": "Private Network",
                "asn": "N/A",
                "is_private": True,
            }
            GEOIP_CACHE[ip] = location
            return location
        # No user location available, return None
        return None

    # Try GeoLite2 database
    if geo_reader:
        try:
            response = geo_reader.get(ip)
            if response and "location" in response:
                lat = response["location"].get("latitude", 0)
                lon = response["location"].get("longitude", 0)
                if lat != 0 or lon != 0:
                    location = {
                        "ip": ip,
                        "lat": lat,
                        "lon": lon,
                        "country": response.get("country", {})
                        .get("names", {})
                        .get("en", "Unknown"),
                        "city": response.get("city", {})
                        .get("names", {})
                        .get("en", "Unknown"),
                        "isp": "Unknown",
                        "asn": "Unknown",
                        "is_private": False,
                    }
                    GEOIP_CACHE[ip] = location
                    return location
        except:
            pass

    # Try live API as fallback for public IPs (used when loading PCAP files)
    # Request proxy/hosting fields for VPN detection
    try:
        response = requests.get(
            f"http://ip-api.com/json/{ip}?fields=status,country,city,lat,lon,isp,as,query,proxy,hosting",
            timeout=2,
        )
        if response.status_code == 200:
            data = response.json()
            if data.get("status") == "success":
                isp = data.get("isp", "Unknown")
                asn = data.get("as", "Unknown")
                is_proxy = data.get("proxy", False)
                is_hosting = data.get("hosting", False)

                # Detect VPN using enhanced multi-layer detection
                vpn_info = detect_vpn(ip, isp, asn)

                # If ip-api says it's a proxy but our detector missed it
                if not vpn_info["is_vpn"] and is_proxy:
                    vpn_info = {
                        "is_vpn": True,
                        "provider": f"Proxy/VPN ({isp})",
                        "method": "ip-api-proxy",
                    }
                    VPN_CACHE[f"{ip}_{isp}_{asn}"] = vpn_info

                location = {
                    "ip": ip,
                    "lat": data.get("lat", 0),
                    "lon": data.get("lon", 0),
                    "country": data.get("country", "Unknown"),
                    "city": data.get("city", "Unknown"),
                    "isp": isp,
                    "asn": asn,
                    "is_private": False,
                    "is_vpn": vpn_info["is_vpn"],
                    "vpn_provider": vpn_info.get("provider"),
                    "vpn_method": vpn_info.get("method"),
                    "is_hosting": is_hosting,
                }
                GEOIP_CACHE[ip] = location

                # Track VPN IPs globally
                if vpn_info["is_vpn"]:
                    vpn_ips.add(ip)

                print(
                    f"[INFO] Got geolocation for {ip}: {location['city']}, {location['country']}"
                )
                if vpn_info["is_vpn"]:
                    print(
                        f"[VPN] {ip} identified as {vpn_info.get('provider')} via {vpn_info.get('method')}"
                    )
                return location
    except Exception as e:
        print(f"[WARN] API geolocation failed for {ip}: {e}")

    # Location unknown - return None instead of hash-based fake location
    return None


def is_private_ip(ip: str) -> bool:
    """Check if IP is private"""
    if ":" in ip:
        return ip.startswith("fe80:") or ip.startswith("fc") or ip == "::1"
    try:
        parts = ip.split(".")
        if len(parts) != 4:
            return True
        first = int(parts[0])
        return (
            first in [10, 127, 0]
            or (first == 172 and 16 <= int(parts[1]) <= 31)
            or (first == 192 and int(parts[1]) == 168)
            or first >= 224
        )
    except:
        return True


